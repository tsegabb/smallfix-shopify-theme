<section class="py-12 bg-stone-50 min-h-[60vh]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-stone-900 mb-8">Your Cart</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="space-y-8">
        
        <!-- Free Shipping Threshold -->
        <div class="p-4 bg-stone-100 rounded border border-stone-200">
          {% render 'free-shipping-bar' %}
        </div>

        <!-- Cart Items -->
        <div class="bg-white rounded border border-stone-200 divide-y divide-stone-200 overflow-hidden">
          {%- for item in cart.items -%}
            <div class="p-4 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div class="flex items-center gap-4">
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" class="w-18 h-18 object-cover rounded bg-stone-100 border border-stone-200 shrink-0">
                <div>
                  <h3 class="text-sm font-semibold text-stone-900">
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                  </h3>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="text-xs text-stone-500 mt-0.5">{{ item.variant.title }}</p>
                  {%- endunless -%}
                  <div class="text-sm font-medium text-stone-900 mt-1 tabular-nums">
                    {{ item.final_price | money }}
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-4 self-end sm:self-center">
                <div class="flex items-center border border-stone-300 rounded bg-white text-xs">
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="w-14 text-center py-1 text-sm font-semibold border-0 focus:ring-0">
                </div>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-xs text-stone-400 hover:text-rose-600 transition-colors">
                  Remove
                </a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Cart Notes & Summary -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
          <div>
            <label for="CartNote" class="block text-xs font-semibold text-stone-700 uppercase tracking-wider mb-2">Order Notes / Delivery Instructions</label>
            <textarea name="note" id="CartNote" rows="3" class="w-full p-3 border border-stone-300 rounded text-xs text-stone-800 focus:outline-hidden focus:border-stone-900" placeholder="Optional notes for delivery...">{{ cart.note }}</textarea>
          </div>

          <div class="bg-white p-6 rounded border border-stone-200 space-y-4">
            <div class="flex justify-between text-sm text-stone-600">
              <span>Subtotal</span>
              <span class="text-lg font-bold text-stone-900 tabular-nums">{{ cart.total_price | money }}</span>
            </div>
            <p class="text-xs text-stone-500">Taxes and shipping calculated at secure checkout.</p>

            <!-- Native Shopify Checkout Submit Button -->
            <button type="submit" name="checkout" class="w-full py-4 bg-stone-900 hover:bg-stone-850 text-white font-semibold text-sm rounded transition-colors shadow-sm cursor-pointer flex items-center justify-center gap-2">
              <span>Proceed to Secure Checkout</span>
            </button>

            <!-- Accepted Payment Methods Trust Strip -->
            <div class="pt-3 border-t border-stone-100 flex flex-col items-center gap-2 text-center">
              <span class="text-[11px] text-stone-500 font-medium">Guaranteed Safe & Secure Checkout</span>
              {% render 'payment-icons' %}
            </div>
          </div>
        </div>

      </form>
    {%- else -%}
      <div class="py-16 text-center bg-white rounded border border-stone-200 p-8">
        <p class="text-base text-stone-600 mb-4">Your cart is currently empty.</p>
        <a href="/collections/all" class="inline-block px-6 py-3 bg-stone-900 text-white text-xs font-semibold rounded hover:bg-stone-800 transition-colors">
          Browse Cleaning Gadgets &rarr;
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Main Cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "Enable Cart Notes",
      "default": true
    }
  ]
}
{% endschema %}
