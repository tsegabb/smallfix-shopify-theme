<section class="py-12 bg-stone-50 min-h-[60vh]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center mb-8">
      <h1 class="text-3xl font-bold text-stone-900 mb-4">Search Gadgets</h1>
      <form action="{{ routes.search_url }}" method="get" class="flex gap-2">
        <input type="text" name="q" value="{{ search.terms | escape }}" placeholder="Search cleaning gadgets, spin scrubbers, cords..." class="flex-1 px-4 py-3 bg-white border border-stone-300 rounded text-sm focus:border-stone-900 focus:outline-hidden">
        <button type="submit" class="px-6 py-3 bg-stone-900 text-white font-semibold text-sm rounded hover:bg-stone-850">
          Search
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- else -%}
          <div class="col-span-full py-16 text-center text-sm text-stone-600 bg-white border border-stone-200 rounded">
            No products found matching "{{ search.terms }}".
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Search",
  "settings": []
}
{% endschema %}
